# Settings for `docker compose`. Copy to .env and fill in. Never commit .env.

# Required. Generate with:  openssl rand -hex 48
JWT_SECRET=

# The address people open in the browser (used for CORS).
PUBLIC_URL=http://localhost
HTTP_PORT=80

# First accounts, created on first start. Choose your own passwords
# (8+ characters with a letter and a number). Leave empty to skip.
SEED_ADMIN_EMAIL=admin@cropguard.local
SEED_ADMIN_PASSWORD=
SEED_FARMER_EMAIL=farmer@cropguard.local
SEED_FARMER_PASSWORD=

# Leave as is to use the bundled MongoDB container, or point at MongoDB Atlas.
# MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/cropguard

# Photo storage: "local" (Docker volume) or "s3". On AWS the CloudFormation stack sets these.
STORAGE_DRIVER=local
S3_BUCKET=
AWS_REGION=ap-south-1

# Optional: live mandi prices from https://data.gov.in
DATA_GOV_API_KEY=
