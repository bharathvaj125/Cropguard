# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=5000

# "memory" starts a local mongod automatically (no install needed, data kept in backend/.data).
# For Docker / production use a real URI, e.g. mongodb://mongo:27017/cropguard or a MongoDB Atlas URI.
MONGO_URI=memory

# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Python inference service.
ML_SERVICE_URL=http://localhost:8000

# Where uploaded photos are stored: "local" (disk) or "s3" (AWS S3 bucket).
STORAGE_DRIVER=local
# S3_BUCKET=cropguard-uploads-<account-id>
# AWS_REGION=ap-south-1

# First accounts, created on start-up if they do not exist yet. Choose your own passwords
# (at least 8 characters with a letter and a number). Leave a password empty to skip that account.
SEED_ADMIN_EMAIL=admin@cropguard.local
SEED_ADMIN_PASSWORD=
SEED_FARMER_EMAIL=farmer@cropguard.local
SEED_FARMER_PASSWORD=

# Optional: live mandi prices from https://data.gov.in (free key). Without it the market
# module serves the clearly-labelled sample series bundled with the project.
DATA_GOV_API_KEY=

# Predictions below these scores are reported as "uncertain" rather than as a diagnosis.
DISEASE_CONFIDENCE_THRESHOLD=0.6
PEST_CONFIDENCE_THRESHOLD=0.55

# --- Track B: Claude crop advisory and AWS speech -------------------------------------------
# Claude through Amazon Bedrock (uses the AWS credential chain / EC2 instance role).
# Claude 3.5 Sonnet is retired; use a current model such as anthropic.claude-sonnet-5-5.
# Enable access to the model in the Bedrock console first.
BEDROCK_MODEL_ID=
BEDROCK_REGION=ap-south-1
# ...or directly through the Claude API (used when BEDROCK_MODEL_ID is empty).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high: how hard Claude thinks. medium is a good balance for chat.
LLM_EFFORT=medium
# Force a provider: bedrock | anthropic | off. Empty = choose automatically.
LLM_PROVIDER=

# Amazon Polly text-to-speech (Hindi and Indian English voices only).
POLLY_ENABLED=false
# Amazon Transcribe speech-to-text (all supported Indian languages).
# WebM/MP3/MP4 recordings also need STORAGE_DRIVER=s3; WAV, Ogg-Opus and FLAC do not.
TRANSCRIBE_ENABLED=false
